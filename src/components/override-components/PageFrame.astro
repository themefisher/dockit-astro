---
import MobileMenuToggle from "./MobileMenuToggle.astro";
import Footer from "./Footer.astro";
import CTA from "../CTA.astro";
import SidebarNav from "../SidebarNav.astro";
import ImageMod from "../ImageMod.astro";

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="page sl-flex">
  {
    !hasSidebar ? (
      <div class="hero-bg">
        <ImageMod
          src="/src/assets/hero-bg-light.png"
          alt="Hero Background Light"
          class="dark:hidden w-full h-full object-cover"
          width={1920}
          height={856}
          loading="eager"
          fetchpriority="high"
        />
        <ImageMod
          src="/src/assets/hero-bg-dark.png"
          alt="Hero Background Dark"
          class="hidden dark:block w-full h-full object-cover"
          width={1920}
          height={820}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    ) : (
      <div class="doc-bg">
        <ImageMod
          src="/src/assets/doc-bg.png"
          alt="Documentation Background"
          class="hidden dark:block w-full h-full fixed top-0 left-0"
          width={2000}
          height={1000}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )
  }
  <header class={"header" + (hasSidebar ? " has-sidebar" : " no-sidebar")}>
    <slot name="header" />
  </header>
  {hasSidebar && <SidebarNav />}
  <div class="main-frame">
    <div class="container flex relative">
      {
        hasSidebar && (
          <nav
            class="sidebar print:hidden"
            aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}
          >
            <MobileMenuToggle />

            <div class="sidebar-desktop-shell">
              <div class="dockit-sidebar-controls">
                <button
                  type="button"
                  class="dockit-sidebar-toggle dockit-sidebar-toggle--left"
                  data-sidebar-toggle="left"
                  aria-expanded="true"
                  aria-controls="starlight__sidebar"
                  aria-label="Collapse navigation sidebar"
                  title="Collapse navigation sidebar"
                >
                  <svg class="icon-collapse" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect width="18" height="18" x="3" y="3" rx="2" />
                    <path d="M9 3v18" />
                    <path d="m16 15-3-3 3-3" />
                  </svg>
                  <svg class="icon-expand" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect width="18" height="18" x="3" y="3" rx="2" />
                    <path d="M9 3v18" />
                    <path d="m14 9 3 3-3 3" />
                  </svg>
                </button>
              </div>

              <div id="starlight__sidebar" class="sidebar-pane">
                <div class="sidebar-content sl-flex">
                  <slot name="sidebar" />
                </div>
              </div>

              <div
                class="dockit-resize-handle dockit-resize-handle--left"
                data-sidebar-resize="left"
                role="separator"
                aria-orientation="vertical"
                aria-label="Resize navigation sidebar"
                aria-valuemin="200"
                aria-valuemax="480"
                aria-valuenow="320"
                tabindex="0"
                title="Drag to resize sidebar (double-click to reset)"
              ></div>
            </div>
          </nav>
        )
      }
      <slot />
    </div>
  </div>
  {!hasSidebar && <CTA />}
  {!hasSidebar && <Footer />}
</div>

<style>
  @layer starlight.core {
    .page {
      flex-direction: column;
      min-height: 100vh;
    }
    .header {
      z-index: var(--sl-z-index-navbar);
      /* position: fixed; */
      position: sticky;
      inset-inline-start: 0;
      inset-block-start: 0;
      width: 100%;
      /* height: 4.5rem; */
      border-bottom: 1px solid
        color-mix(in srgb, var(--sl-color-white) 10%, transparent);
      padding: var(--sl-nav-pad-y) 0px;
      /* padding-inline-end: var(--sl-nav-pad-x); */
    }
    .sidebar {
      opacity: 0;
      transition: all 0.3s ease-in-out;
    }
    .sidebar button:where(.astro-jif73yzw) {
      top: 14px !important;
    }
    footer {
      display: none;
    }
    @media (max-width: 800px) {
      .header {
        background-color: var(--sl-color-black);
        padding: 6px var(--sl-nav-pad-x);
      }
    }

    :global([data-has-sidebar]) .main-frame {
      padding-top: 2rem;
    }
    @media (max-width: 1156px) {
      :global([data-has-sidebar]) .main-frame {
        padding-top: 4rem;
      }
    }

    .sidebar-pane {
      visibility: var(--sl-sidebar-visibility, hidden);
      position: sticky;
      height: 80vh;
      z-index: var(--sl-z-index-menu);
      scrollbar-width: none;
      background-color: var(--sl-color-black);
      overflow-y: scroll;
      inset-inline-start: 0;
      width: 100%;
      padding-bottom: 2rem;
    }
    @media (max-width: 1024px) {
      .sidebar-pane {
        inset-block: var(--sl-nav-height);
      }
    }
    @media (max-width: 799px) {
      .sidebar-pane {
        position: fixed;
        padding: 0 2rem;
        height: 100vh;
      }
    }

    .sidebar-desktop-shell {
      display: contents;
    }
    .dockit-sidebar-controls,
    .dockit-resize-handle--left {
      display: none;
    }

    :global([aria-expanded="true"]) ~ .sidebar-pane,
    :global([aria-expanded="true"]) ~ .sidebar-desktop-shell .sidebar-pane {
      --sl-sidebar-visibility: visible;
    }
    .sidebar-content {
      height: 100%;
      min-height: max-content;
      padding: 1rem var(--sl-sidebar-pad-x) 0;
      flex-direction: column;
      gap: 1rem;
      padding-top: 0px;
      padding-left: 0px;
      content: "";
      padding-bottom: 1px;
    }

    @media (min-width: 50rem) {
      .sidebar {
        flex-shrink: 0;
      }
      .sidebar-desktop-shell {
        display: flex;
        flex-direction: column;
        position: sticky;
        inset-block: calc(var(--sl-nav-height) + 110px) 0;
        height: 80vh;
        width: var(--dockit-left-sidebar-width, var(--sl-sidebar-width));
        transition: width 0.2s ease;
      }
      .dockit-sidebar-controls {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        padding-inline-end: 0.75rem;
        padding-bottom: 0.5rem;
        flex-shrink: 0;
      }
      .sidebar-pane {
        --sl-sidebar-visibility: visible;
        position: static;
        width: 100%;
        flex: 1;
        min-height: 0;
        height: auto;
        background-color: transparent;
      }
      .dockit-resize-handle--left {
        display: block;
        inset-inline-end: -4px;
      }

      :global(html[data-left-sidebar-collapsed="true"]) .sidebar-desktop-shell {
        width: 2.5rem;
      }
      :global(html[data-left-sidebar-collapsed="true"]) .dockit-sidebar-controls {
        justify-content: center;
        padding-inline-end: 0;
      }
      :global(html[data-left-sidebar-collapsed="true"]) .sidebar-pane {
        width: 0;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        padding: 0;
        overflow: hidden;
      }
      :global(html[data-left-sidebar-collapsed="true"]) .dockit-resize-handle--left {
        display: none;
      }
      :global(html[data-left-sidebar-collapsed="true"]) .dockit-sidebar-toggle--left .icon-collapse {
        display: none;
      }
      :global(html:not([data-left-sidebar-collapsed="true"])) .dockit-sidebar-toggle--left .icon-expand {
        display: none;
      }
    }
  }
</style>

<style is:global>
  @layer starlight.core {
    .dockit-sidebar-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.75rem;
      height: 1.75rem;
      border-radius: 0.375rem;
      border: 1px solid var(--sl-color-hairline);
      background-color: transparent;
      color: var(--sl-color-gray-3);
      cursor: pointer;
      flex-shrink: 0;
      transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
    }
    .dockit-sidebar-toggle:hover,
    .dockit-sidebar-toggle:focus-visible {
      color: var(--sl-color-white);
      border-color: var(--sl-color-gray-4);
      background-color: color-mix(in srgb, var(--sl-color-white) 6%, transparent);
    }
    .dockit-sidebar-toggle:focus-visible {
      outline: 2px solid var(--sl-color-accent);
      outline-offset: 2px;
    }

    .dockit-resize-handle {
      position: absolute;
      top: 0;
      width: 8px;
      height: 100%;
      cursor: col-resize;
      z-index: 20;
      touch-action: none;
      outline: none;
    }
    .dockit-resize-handle::after {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      inset-inline-start: 3px;
      width: 2px;
      background-color: transparent;
      transition: background-color 0.15s ease;
    }
    .dockit-resize-handle:hover::after,
    .dockit-resize-handle:focus-visible::after,
    .dockit-resize-handle[data-active="true"]::after {
      background-color: var(--sl-color-accent);
    }

    html[data-resizing="true"],
    html[data-resizing="true"] * {
      user-select: none !important;
      cursor: col-resize !important;
      transition: none !important;
    }
  }
</style>

<script>
  import { initSidebarLayout } from "@/lib/utils/sidebarLayout";

  // Initialize sidebar functionality
  function initializeSidebar(): void {
    const sidebar = document.querySelector(".sidebar") as HTMLElement | null;
    if (sidebar) {
      sidebar.style.opacity = "1";
    }
    initSidebarLayout();
  }

  // Initialize sidebar when DOM is ready and on view transitions
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeSidebar);
  } else {
    initializeSidebar();
  }
  document.addEventListener("astro:page-load", initializeSidebar);

  // accordion
  const accordions = document.querySelectorAll(
    ".accordion"
  ) as NodeListOf<HTMLElement>;

  accordions.forEach((accordion) => {
    // close other accordions when one is opened
    accordion.addEventListener("click", () => {
      accordions.forEach((otherAccordion) => {
        if (otherAccordion !== accordion) {
          otherAccordion.classList.remove("active");
        }
      });
      accordion.classList.toggle("active");
    });
  });
</script>
