---
import TableOfContentsList from "./TableOfContents/TableOfContentsList.astro";

const { toc } = Astro.locals.starlightRoute;
---

{
  toc && (
    <starlight-toc
      data-min-h={toc.minHeadingLevel}
      data-max-h={toc.maxHeadingLevel}
    >
      <nav aria-labelledby="starlight__on-this-page">
        <div class="dockit-toc-header">
          <h2 id="starlight__on-this-page" class="uppercase">
            <svg
              width="12"
              height="12"
              viewBox="0 0 12 12"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M1.375 6H10.625M1.375 2.875H10.625M1.375 9.125H5.75"
                stroke="#A3A3A3"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>

            <span>{Astro.locals.t("tableOfContents.onThisPage")}</span>
          </h2>
          <button
            type="button"
            class="dockit-sidebar-toggle dockit-sidebar-toggle--right"
            data-sidebar-toggle="right"
            aria-expanded="true"
            aria-controls="starlight__toc-body"
            aria-label="Collapse table of contents"
            title="Collapse table of contents"
          >
            <svg class="icon-collapse" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="18" height="18" x="3" y="3" rx="2" />
              <path d="M15 3v18" />
              <path d="m8 9 3 3-3 3" />
            </svg>
            <svg class="icon-expand" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="18" height="18" x="3" y="3" rx="2" />
              <path d="M15 3v18" />
              <path d="m10 15-3-3 3-3" />
            </svg>
          </button>
        </div>
        <div id="starlight__toc-body">
          <TableOfContentsList toc={toc.items} />
        </div>
      </nav>
    </starlight-toc>
  )
}

<script src="./TableOfContents/starlight-toc"></script>

<style>
  @layer starlight.core {
    .dockit-toc-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      padding-inline-start: 1.5rem;
      padding-inline-end: 0.25rem;
      margin-bottom: 1.5rem;
    }
    #starlight__on-this-page {
      font-size: 12px !important;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0 !important;
    }
    @media (min-width: 72rem) {
      :global(html[data-right-sidebar-collapsed="true"]) .dockit-toc-header {
        padding-inline: 0;
        padding-block: 0.25rem;
        justify-content: center;
        margin-bottom: 0;
      }
      :global(html[data-right-sidebar-collapsed="true"]) #starlight__on-this-page,
      :global(html[data-right-sidebar-collapsed="true"]) #starlight__toc-body {
        display: none;
      }
    }
    :global(html[data-right-sidebar-collapsed="true"]) .dockit-sidebar-toggle--right .icon-collapse {
      display: none;
    }
    :global(html:not([data-right-sidebar-collapsed="true"])) .dockit-sidebar-toggle--right .icon-expand {
      display: none;
    }
  }
</style>