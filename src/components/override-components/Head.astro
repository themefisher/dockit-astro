---
import { AstroFont } from "astro-font";
import theme from "@/config/theme.json";
const { head } = Astro.locals.starlightRoute;

// font families
const pf = theme.fonts.font_family.primary;
// @ts-ignore
const sf = theme.fonts.font_family.secondary ;

let fontPrimary, fontSecondary;
if (theme.fonts.font_family.primary) {
  fontPrimary = theme.fonts.font_family.primary
    .replace(/\+/g, " ")
    .replace(/:[ital,]*[ital@]*[wght@]*[0-9,;.]+/gi, "");
}
// @ts-ignore
if (theme.fonts.font_family.secondary) {
// @ts-ignore
  fontSecondary = theme.fonts.font_family.secondary
    .replace(/\+/g, " ")
    .replace(/:[ital,]*[ital@]*[wght@]*[0-9,;.]+/gi, "");
}

---

{head.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}

<!-- google font css -->
    <AstroFont
      config={[
        {
          src: [],
          preload: false,
          display: "swap",
          name: fontPrimary!,
          fallback: "sans-serif",
          cssVariable: "font-primary",
          googleFontsURL: `https://fonts.googleapis.com/css2?family=${pf}&display=swap`,
        },
        {
          src: [],
          preload: false,
          display: "swap",
          name: fontSecondary!,
          fallback: "sans-serif",
          cssVariable: "font-secondary",
          googleFontsURL: `https://fonts.googleapis.com/css2?family=${sf}&display=swap`,
        },
      ]}
    />

<script is:inline>
  (() => {
    const applySavedSidebars = () => {
      try {
        const root = document.documentElement;
        if (localStorage.getItem("dockit-left-sidebar-collapsed") === "true") {
          root.dataset.leftSidebarCollapsed = "true";
        } else {
          delete root.dataset.leftSidebarCollapsed;
        }
        if (localStorage.getItem("dockit-right-sidebar-collapsed") === "true") {
          root.dataset.rightSidebarCollapsed = "true";
        } else {
          delete root.dataset.rightSidebarCollapsed;
        }

        const lw = Number.parseFloat(localStorage.getItem("dockit-left-sidebar-width") || "");
        if (Number.isFinite(lw) && lw > 0) {
          root.style.setProperty("--dockit-left-sidebar-width", `${Math.round(Math.min(480, Math.max(200, lw)))}px`);
        }

        const rw = Number.parseFloat(localStorage.getItem("dockit-right-sidebar-width") || "");
        if (Number.isFinite(rw) && rw > 0) {
          root.style.setProperty("--dockit-right-sidebar-width", `${Math.round(Math.min(420, Math.max(180, rw)))}px`);
        }
      } catch {
        // Ignore localStorage access errors
      }
    };

    applySavedSidebars();
    if (!document.__dockitSidebarSwapBound) {
      document.__dockitSidebarSwapBound = true;
      document.addEventListener("astro:after-swap", applySavedSidebars);
    }
  })();
</script>

